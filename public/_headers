  Content-Security-Policy: default-src 'none'; connect-src https://pccs.phala.network https://api.trustedservices.intel.com; script-src 'self' 'unsafe-eval'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
