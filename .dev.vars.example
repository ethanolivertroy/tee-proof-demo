# The Deploy to Cloudflare wizard stores these as Worker secrets and may
# pre-fill the values below, so every value is left empty on purpose. The
# Worker answers 503 on every /api route until all three are set.
# Create your own provider keys and never commit their values.
NEAR_AI_API_KEY=
PHALA_API_KEY=

# Owner gate for every /api route. Use 20 to 256 random characters, for
# example the output of: openssl rand -hex 32
DEMO_ACCESS_TOKEN=
